# Copy to .env.production and replace every placeholder. Never commit real secrets.
# Runtime file: no MIGRATION_DATABASE_URL here.
ENVIRONMENT=production
AUTH_MODE=oidc
APP_ID=minha-app
PROJECT_NAME=Minha aplicação
HOST=127.0.0.1
PORT=8000
PUBLIC_URL=https://minha-app.guilarde.com
COOKIE_SECURE=true
SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DATABASE_URL=postgresql+psycopg://guilarde_app:REPLACE_PASSWORD@postgres:5432/REPLACE_DATABASE
OIDC_ISSUER=https://auth.guilarde.com/application/o/minha-app/
OIDC_CLIENT_ID=REPLACE_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_CLIENT_SECRET
OIDC_AUDIENCE=minha-app
CORE_URL=https://core.guilarde.com
LOG_FORMAT=json
