# Generate a real .env with scripts/bootstrap.py. Never commit it.
APP_ID=suite-example
PROJECT_NAME=Guilarde Suite
ENVIRONMENT=development
AUTH_MODE=oidc
# Only used by the dev CLI profile; production database credentials are ignored in dev.
DEV_DATABASE_URL=sqlite:///./.local/dev.sqlite3
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
SESSION_ENCRYPTION_KEY=
POSTGRES_DB=guilarde
POSTGRES_USER=guilarde_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://guilarde_app:CHANGE_ME@localhost:5432/guilarde
MIGRATION_DATABASE_URL=postgresql+psycopg://guilarde_owner:CHANGE_ME@localhost:5432/guilarde
OIDC_ISSUER=https://auth.guilarde.com/application/o/suite-example/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=suite-example
CORE_URL=https://core.guilarde.com
LOG_FORMAT=json
